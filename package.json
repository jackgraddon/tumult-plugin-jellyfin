{
    "name": "tumult-plugin-jellyfin",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "A Jellyfin media server client for Tumult: your library, your music, a player.",
    "packageManager": "pnpm@11.13.1",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "vite build",
        "typecheck": "vue-tsc -p tsconfig.json --noEmit",
        "shim": "node scripts/gen-vue-shim.mjs",
        "release": "node scripts/release.mjs",
        "release:dry": "pnpm build && node scripts/make-release-manifest.mjs"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.9",
        "typescript": "^5.9.3",
        "vite": "^7.3.6",
        "vue": "^3.5.22",
        "vue-tsc": "^3.3.11"
    }
}
