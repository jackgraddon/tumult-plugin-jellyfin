{
    "//": "Local deviation from the template: this plugin's sources import with",
    "//2": "explicit '.ts' extensions (the style the Tumult repo uses), which",
    "//3": "TypeScript only accepts when 'allowImportingTsExtensions' is on.",
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "types": [],
        "baseUrl": ".",
        "paths": {
            "@tumult/ui": ["./types/plugin.d.ts"],
            "@tumult/core": ["./types/plugin.d.ts"],
            "vue": ["./node_modules/vue"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.vue", "types/**/*.d.ts"]
}
